{
  "expo": {
    "name": "Prayer Reminder",
    "slug": "prayer-reminderv1",
    "scheme": "prayer-reminderv1",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nurqalik.prayerreminderv1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#ffffff"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "VIBRATE",
        "WAKE_LOCK",
        "SCHEDULE_EXACT_ALARM",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "package": "com.nurqalik.prayerreminderv1"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-notifications",
      "expo-task-manager",
      "expo-background-fetch",
      "expo-font",
      "expo-asset",
      "expo-router",
      "expo-web-browser",
      "expo-image-picker",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-dark2.png",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Hello",
              "label": "My Hello Widget",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "description": "This is my first widget",
              "previewImage": "./assets/adaptive-icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Counter",
              "label": "My Counter Widget",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "description": "This is my second widget",
              "previewImage": "./assets/adaptive-icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Prayer",
              "label": "Prayer Widget",
              "minWidth": "320dp",
              "minHeight": "120dp",
              "targetCellWidth": 5,
              "targetCellHeight": 2,
              "description": "Prayer Widget",
              "previewImage": "./assets/adaptive-icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4564d11a-1f1c-40e5-abf9-2c2b1bae043e"
      }
    }
  }
}
